# Fins de ligne stables : LF dans le dépôt, quel que soit le poste (Windows, Mac, Linux).
* text=auto eol=lf

# Fichiers binaires : jamais de conversion.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary
*.glb binary
*.gltf binary
*.mp3 binary
*.ogg binary
*.woff binary
*.woff2 binary

# Fichiers générés : pas de bruit dans les diffs.
package-lock.json linguist-generated=true
